+// finance experiment runner: node scripts/exp.js --games=300 --out=file.json  (knobs via env)
+import { readFileSync, writeFileSync } from 'node:fs';
+import { createEngine } from '../src/engine/engine.js';
+import { step, BOTS } from '../src/engine/bots.js';
+import { totalExpenses, monthlyCashFlow, passiveIncome } from '../src/engine/selectors.js';
+const read = (p) => JSON.parse(readFileSync(new URL(p, import.meta.url), 'utf8'));
+const data = { professions: read('../src/data/professions.he.json'), cards: read('../src/data/cards.he.json') };
+const engine = createEngine(data);
+const args = Object.fromEntries(process.argv.slice(2).map((a) => { const [k, v] = a.replace(/^--/, '').split('='); return [k, v ?? true]; }));
+const GAMES = Number(args.games ?? 300), MAX = Number(args.max ?? 200);
+const bots = (args.bots ?? 'sensible,cautious,alwaysBuy,overBorrow,overBorrowLite,alwaysPass').split(',');
+const q = (a, p) => { const s = [...a].sort((x, y) => x - y); return s.length ? s[Math.min(s.length - 1, Math.floor(p * s.length))] : null; };
+const profs = data.professions.map((p) => p.id);
+function play(mode, bot, pid, seed) {
+  let s = engine.newGame({ mode, professionId: pid, seed });
+  let cash10 = null, guard = 0;
+  while (s.status === 'playing' && s.turn < MAX && guard++ < 5000) {
+    s = step(engine, s, bot);
+    if (cash10 === null && s.turn >= 10 && s.phase === 'roll') cash10 = s.cash;
+  }
+  return { s, cash10 };
+}
+const out = { knobs: { PAYDAY_MONTHS: process.env.PAYDAY_MONTHS ?? 24, PAYDAY_TILES: process.env.PAYDAY_TILES ?? 5, PRICE_INFLATION: process.env.PRICE_INFLATION ?? 1, EXPENSE_INFLATION: process.env.EXPENSE_INFLATION ?? 1, FAMILY_MARKET: process.env.FAMILY_MARKET ?? 0, LOAN_CAP: process.env.LOAN_CAP ?? 12, LOAN_LIMIT_PCT: process.env.LOAN_LIMIT_PCT ?? 0.2 }, rows: [], prof: [] };
+for (const mode of ['family', 'full']) {
+  for (const bot of bots) {
+    const r = { wins: [], lost: 0, timeout: 0, loans: [], cash10: [], n: 0 };
+    for (let g = 0; g < GAMES; g++) {
+      const { s, cash10 } = play(mode, bot, profs[g % profs.length], 1000 + g * 7919);
+      r.n++; r.loans.push(s.stats.loansTaken); if (cash10 !== null) r.cash10.push(cash10);
+      if (s.status === 'won') r.wins.push(s.turn); else if (s.status === 'lost') r.lost++; else r.timeout++;
+    }
+    out.rows.push({ mode, bot, n: r.n, win: r.wins.length / r.n, lost: r.lost / r.n, timeout: r.timeout / r.n, median: q(r.wins, 0.5), p90: q(r.wins, 0.9), over40: r.wins.filter((t) => t > 40).length / r.n, p10: q(r.wins, 0.1), loans: r.loans.reduce((a, b) => a + b, 0) / r.n, cash10: q(r.cash10, 0.5) });
+  }
