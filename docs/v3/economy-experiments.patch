+import { readFileSync } from 'node:fs';
+import { createEngine } from '../src/engine/engine.js';
+import { step } from '../src/engine/bots.js';
+import { dailySeed, dailyProfessionId } from '../src/engine/daily.js';
+const read = (p) => JSON.parse(readFileSync(new URL(p, import.meta.url), 'utf8'));
+const data = { professions: read('../src/data/professions.he.json'), cards: read('../src/data/cards.he.json') };
+const engine = createEngine(data);
+let diffTurns = 0, total = 0, games = 0, lapMismatchGames = 0, maxDelta = 0;
+for (let day = 1; day <= 60; day++) {
+  const date = `2026-11-${String((day % 28) + 1).padStart(2, '0')}-${day}`.slice(0, 10);
+  const key = `2027-${String(1 + (day % 12)).padStart(2, '0')}-${String(1 + (day % 28)).padStart(2, '0')}`;
+  const seed = dailySeed(key);
+  const laps = {};
+  for (const bot of ['sensible', 'alwaysPass']) {
+    let s = engine.newGame({ mode: 'family', professionId: dailyProfessionId(seed, data.professions), seed, daily: { date: key } });
+    const arr = [];
+    let g = 0;
+    while (s.status === 'playing' && s.turn < 30 && g++ < 3000) { s = step(engine, s, bot); if (s.phase === 'roll') arr[s.turn] = s.lap; }
+    laps[bot] = arr;
+  }
+  games++;
+  let mism = false;
+  for (let t = 1; t < 30; t++) { if (laps.sensible[t] == null || laps.alwaysPass[t] == null) continue; total++; if (laps.sensible[t] !== laps.alwaysPass[t]) { diffTurns++; mism = true; maxDelta = Math.max(maxDelta, Math.abs(laps.sensible[t] - laps.alwaysPass[t])); } }
+  if (mism) lapMismatchGames++;
+}
+console.log({ games, total, diffTurns, lapMismatchGames, maxDelta });
